{
  "name": "@ggfincke/worker-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Local native-harness worker broker for Claude Code orchestration",
  "type": "module",
  "bin": {
    "worker-broker": "dist/src/cli.js",
    "worker-broker-mcp": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-build-id.mjs",
    "ccusage": "npm run build --silent >/dev/null && node dist/src/cli.js ccusage --",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run clean && npm run build && node --test 'dist/tests/**/*.test.js'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
