{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 8000
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": ["summary", "assumptions", "risks", "follow_ups"]
}
